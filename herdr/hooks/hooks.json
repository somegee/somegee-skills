{
  "description": "herdr 터미널에 Claude 세션 id 이름표 달기 (웹 관제 화면의 대화 보기용). python 이 없거나 막혀도 조용히 넘어간다",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(python \"${CLAUDE_PLUGIN_ROOT}/hooks/label_session.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/label_session.py\") >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
